# Copy with scripts/init-env.sh: it fills every empty secret below with a
# random value. .env is gitignored; never commit it.

# --- Environment ------------------------------------------------------------
# Local: compose.yml:compose.local.yml  |  VPS: compose.yml:compose.vps.yml
COMPOSE_FILE=compose.yml:compose.local.yml
COMPOSE_PROJECT_NAME=devdocker

# http locally; https on the VPS (TLS terminated by the edge Caddy).
PUBLIC_SCHEME=http
RALLLY_HOST=rallly.localhost
AUTHENTIK_HOST=authentik.localhost
MAIL_HOST=mail.localhost

# Rallly image tag from ghcr.io/wiibleyde/rallly: `main` follows the fork,
# `sha-<7 chars>` pins a build (rollback).
RALLLY_TAG=main

# Demo accounts (demo-admin, demo-user, demo-denied) are created by the
# Authentik blueprint as <name>@DEMO_EMAIL_DOMAIN with DEMO_PASSWORD.
DEMO_EMAIL_DOMAIN=devdocker.test

# --- Secrets (generated) ----------------------------------------------------
# Authentik's `akadmin` password (login: akadmin).
AUTHENTIK_BOOTSTRAP_PASSWORD=
DEMO_PASSWORD=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=
RALLLY_DB_PASSWORD=
# >= 32 chars, signs Rallly sessions.
RALLLY_SECRET_PASSWORD=
RALLLY_OIDC_CLIENT_ID=rallly
RALLLY_OIDC_CLIENT_SECRET=
GARAGE_RPC_SECRET=
# Garage wants GK + 24 hex for the key id, 64 hex for the secret.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
